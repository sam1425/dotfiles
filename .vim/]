" ======================
"        Plugins
" ======================
call plug#begin()

Plug 'morhetz/gruvbox'
Plug 'tribela/vim-transparent'
Plug 'sheerun/vim-polyglot'
Plug 'mg979/vim-visual-multi', {'branch': 'master'}
Plug 'machakann/vim-highlightedyank'
Plug 'cofyc/vim-uncrustify'
Plug 'tpope/vim-commentary'

call plug#end()

"Plug 'plasticboy/vim-markdown'

augroup uncrustify_maps
  autocmd!
  autocmd FileType c   nnoremap <buffer> <C-f> :call Uncrustify('c')<CR>
  autocmd FileType c   vnoremap <buffer> <C-f> :call RangeUncrustify('c')<CR>
  autocmd FileType cpp nnoremap <buffer> <C-f> :call Uncrustify('cpp')<CR>
  autocmd FileType cpp vnoremap <buffer> <C-f> :call RangeUncrustify('cpp')<CR>
augroup END

"fix problem with st/vim comment if you are not on st
autocmd FocusLost * call system('xclip -selection clipboard -in', @+)
autocmd TextYankPost * call system('xclip -selection clipboard -in', @+)

command! MakeTags !ctags -R .

let g:uncrustify_config_path = expand('~/.config/uncrustify/uncrustify.cfg')
let g:uncrustify_lang_c   = 'c'
let g:uncrustify_lang_cpp = 'cpp'

syntax on
filetype plugin indent on
set nocompatible
set nocursorline
set nocursorcolumn
set number
set ai
set laststatus=0
set tabstop=4
"set linespace=4
set shiftwidth=4
set softtabstop=4
set expandtab
set clipboard=unnamed,unnamedplus
"set noesckeys
set nowrap
set ignorecase
set smartcase
set incsearch
set cinoptions=l1
"set modeline
set autoindent
set autochdir
set termguicolors
set background=dark

set signcolumn=yes
set updatetime=300

set list
set listchars=tab:\ \ ,trail:·

set path+=**
set wildmenu

set relativenumber
set undofile
set undodir=~/.vim/filebackups/

set makeprg=just
" =========================
" Buffer-local options
" =========================
setlocal fileformat=unix

" Force to not show flash things at startup
set t_ut=
augroup transparent_fixes
    autocmd!
    autocmd ColorScheme * highlight Normal         guibg=NONE ctermbg=NONE
    autocmd ColorScheme * highlight StatusLine     guibg=NONE ctermbg=NONE guifg=NONE ctermfg=NONE
    autocmd ColorScheme * highlight StatusLineNC   guibg=NONE ctermbg=NONE guifg=NONE ctermfg=NONE
    autocmd ColorScheme * highlight StatusLineTerm   guibg=NONE ctermbg=NONE
    autocmd ColorScheme * highlight StatusLineTermNC guibg=NONE ctermbg=NONE
augroup END
let g:gruvbox_contrast_dark = 'hard'
let g:gruvbox_transparent_bg = 1
colorscheme gruvbox

"Bash
let g:is_bash = 1

"Markdown
let g:vim_markdown_folding_disabled = 0   " enable folding
let g:vim_markdown_auto_insert_bullets = 1
let g:vim_markdown_new_list_item_indent = 2
let g:vim_markdown_frontmatter = 1
let g:vim_markdown_conceal = 0

" =========================
" Sessions
" =========================
set sessionoptions=blank,buffers,curdir,folds,help,tabpages,winsize,winpos,terminal,localoptions

" =========================
" Leader key
" =========================
let mapleader=" "

" =========================
" File detection
" =========================
let g:c_syntax_for_h = 1

" =========================
" Disable default plugins
" =========================
let g:loaded_netrw       = 1
let g:loaded_netrwPlugin= 1
let g:loaded_gzip        = 1
let g:loaded_tar         = 1
let g:loaded_tarPlugin  = 1
let g:loaded_zip        = 1
let g:loaded_zipPlugin  = 1
let g:loaded_tutor      = 1
let g:loaded_tohtml     = 1
let g:loaded_rplugin    = 1

let g:undolevels = 1000
let g:highlightedyank_highlight_duration = 100
highlight HighlightedyankRegion ctermbg=0 guibg=#8ec07c

let g:VM_maps = {}
let g:VM_maps["Undo"] = 'u'
let g:VM_maps["Redo"] = '<C-r>'
let g:VM_maps['Exit'] = '<Esc>'

nmap <C-k> <Plug>(VM-Add-Cursor-Up)
nmap <C-j> <Plug>(VM-Add-Cursor-Down)
