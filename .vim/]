function! ToggleTitleCase()
    let save_cursor = getcurpos()
    silent! %s/\<\(\w\)\(\w*\)\>/\u\1\L\2/g
    call setpos('.', save_cursor)
endfunction
command! Uppercasefile call ToggleTitleCase()

if !has('gui_running')
    set ttimeoutlen=10
    let &t_EI = "\<Esc>[2 q" " Normal
    let &t_SI = "\<Esc>[6 q" " Insert
    let &t_SR = "\<Esc>[4 q" " Replace
endif


set fillchars=eob:\ 
