#!/usr/bin/env bash
# install - Symlink dotfiles using GNU Stow
#
# Usage: ./install [mode]
#
# Modes:
#   sys  - Symlink system dotfiles from .files/system to the root (/) directory.
#          Requires sudo privileges.
#   all  - Symlink base dotfiles, system dotfiles, and everything in .files/.
#   (none) - Default mode. Symlinks only base dotfiles in the current directory,
#            ignoring the .files/ directory.
#
# This script will check for 'stow' and attempt to install it using the 
# system's package manager if it is not installed.
set -e

gum_confirm() {
    if command -v gum &>/dev/null; then
        gum confirm "$1" --default="$2"
    else
        local prompt="$1"
        local default="$2"
        if [[ "$default" == "true" ]]; then
            prompt="$prompt [Y/n] "
        else
            prompt="$prompt [y/N] "
        fi
        read -r -p "$prompt"
        [[ "$REPLY" =~ ^[Yy]$ ]] || [[ -z "$REPLY" && "$default" == "true" ]]
    fi
}

if ! command -v stow &>/dev/null; then
    echo "stow is not installed."
    if gum_confirm "Install stow?" "true"; then
        [[ -f /etc/os-release ]] && . /etc/os-release
        case "$ID" in
            arch|artix)
                sudo pacman -S --noconfirm stow ;; debian|ubuntu|pop|mint)
                sudo apt-get update -qq && sudo apt-get install -y stow ;;
            fedora|nobara)
                sudo dnf install -y stow ;;
            void)
                sudo xbps-install -Sy stow ;;
            *)
                echo "Package manager not supported. Please install 'stow' manually."
                exit 1 ;;
        esac
    else
        exit 1
    fi
fi

MODE=$1

if [[ "$MODE" == "sys" ]]; then
    SYSTEMDIR=".files/system"
    sudo stow --adopt -d $SYSTEMDIR -t / .
    echo "System dotfiles Symlinked"
elif [[ "$MODE" == "all" ]]; then
    DIR="."
    FULLDIR=".files"
    SYSTEMDIR=".files/system"
    if [[ -d $SYSTEMDIR  ]]; then
        stow --adopt -t ~ .
        sudo stow --adopt -d $SYSTEMDIR -t / $DIR
        stow --adopt --ignore='system' --ignore='suckless' -d "$FULLDIR" $DIR
        echo "ALL Dotfiles Symlinked"
        if gum_confirm "Build and install suckless tools (dwm, st-flexipatch, dwmblocks-async)?" "false"; then
            SUCK_DIR="$FULLDIR/suckless"
            for dir in dwm st-flexipatch dwmblocks-async; do
                if [[ -d "$SUCK_DIR/$dir" ]]; then
                    echo "Building $dir..."
                    make -C "$SUCK_DIR/$dir" clean 2>/dev/null
                    make -C "$SUCK_DIR/$dir" -j"$(nproc)"
                    sudo make -C "$SUCK_DIR/$dir" install
                    echo "$dir installed."
                else
                    echo "Skipping $dir — directory not found."
                fi
            done
        fi
    fi
    exit 0
else
    DIR="."
    stow --adopt -t ~ --ignore='.files' .
    echo "Dotfiles Symlinked"
fi
