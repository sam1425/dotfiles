term_w=$(tput cols)

print_centered() {
    awk -v term_w="$term_w" '
    {
        # strip ANSI
        s = $0
        gsub(/\033\[[0-9;]*[mK]/, "", s)
        if (length(s) > max_w) max_w = length(s)
        lines[NR] = $0
    }
    END {
        pad = int((term_w - max_w) / 2)
        for (i = 1; i <= NR; i++) {
            printf "%*s%s\n", pad, "", lines[i]
        }
    }
    ' <<< "$1"
}

