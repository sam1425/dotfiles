#!/usr/bin/env sh

# Fix 1: Dynamically resolve DISPLAY if empty, and expand Xauthority path options
if [ -z "$DISPLAY" ]; then
  DISPLAY="$(pgrep -a Xorg 2>/dev/null | grep -o ':[0-9]' | head -n 1)"
  export DISPLAY="${DISPLAY:-:0}"
fi

if [ -z "$XAUTHORITY" ]; then
  if [ -f "$HOME/.Xauthority" ]; then
    export XAUTHORITY="$HOME/.Xauthority"
  elif [ -n "$XDG_RUNTIME_DIR" ] && [ -f "$XDG_RUNTIME_DIR/Xauthority" ]; then
    export XAUTHORITY="$XDG_RUNTIME_DIR/Xauthority"
  else
    export XAUTHORITY="$(ls -1t /tmp/xauth_* 2>/dev/null | head -n 1)"
  fi
fi

kill_pid() {
  if [ -f "$1" ]; then
    pid="$(cat "$1" 2>/dev/null)"
    [ -n "$pid" ] && kill -15 "$pid" 2>/dev/null
    rm -f "$1"
  fi
}

record() {
  amixer set Capture toggle

  # Uses VA-API (Intel/AMD CPU integrated graphics acceleration) if available, otherwise falls back to software encoding
  if [ -e /dev/dri/renderD128 ]; then
    ffmpeg -vaapi_device /dev/dri/renderD128 -s "$(xdpyinfo | awk '/dimensions/{print $2}')" -f x11grab -r 30 -i "$DISPLAY" -vf "format=nv12,hwupload" -c:v h264_vaapi "$HOME/video_$(date '+%a__%b%d__%H_%M_%S').mkv" &
  else
    ffmpeg -s "$(xdpyinfo | awk '/dimensions/{print $2}')" -f x11grab -r 30 -i "$DISPLAY" -c:v h264 -qp 0 "$HOME/video_$(date '+%a__%b%d__%H_%M_%S').mkv" &
  fi
  echo $! > /tmp/recpid

  ffmpeg -f alsa -i sysdefault -af "afftdn=nf=-75" "$HOME/audio_$(date '+%a__%b%d__%H_%M_%S').wav" &
  echo $! > /tmp/audpid

  echo "Rec •" > /tmp/recordingicon && pkill -RTMIN+3 dwmblocks

  notify-send -t 500 -h string:bgcolor:#a3be8c "Recording started & mic toggled"
}

end() {
  kill_pid /tmp/recpid
  kill_pid /tmp/audpid

  amixer set Capture toggle

  echo "" > /tmp/recordingicon && pkill -RTMIN+3 dwmblocks

  notify-send -t 500 -h string:bgcolor:#bf616a "Recording ended "
}

([ -f /tmp/recpid ] && end && exit 0) || record
