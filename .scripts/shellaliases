
bgr() {
    feh --bg-scale "$(find ~/Pictures/wallpaper -type f | shuf -n1)"
}

xkillw(){
    xdotool windowkill $(slop -f '%i') >/dev/null 2>&1
}

xpropw() {
    local id
    id=$(slop -f "%i" -b 2 -p -2 -c 0.2,0.51,0.45,1 2>/dev/null)
    [ -n "$id" ] && xprop -id "$id"
}

emacs() {
    # Save the current tag/desktop index
    local current_tag=$(xdotool get_desktop)
    
    # Jump to Tag 2 (index 1 in xdotool)
    xdotool set_desktop 1
    
    # Open and wait
    emacsclient -a '' "$@"
    
    # Return to the tag you started from
    xdotool set_desktop "$current_tag"
}

calc() {
    qalc "$@"
}

run() {
    ~/.scripts/funcrun
}

update() {
    notify-send "System Update" "Starting upgrade..."

    if pkexec pacman -Syu --noconfirm; then
        notify-send -u normal "System Update" "Upgrade complete."
    else
        notify-send -u critical "System Update" "Upgrade failed with $?."
    fi
}

update_system() {
    PASS=$(printf "" | dmenu -p "sudo password:")
    
    # Validate credentials and cache them (-v = validate only, no command)
    echo "$PASS" | sudo -S -v 2>/dev/null
    local auth=$?
    unset PASS

    if [ $auth -ne 0 ]; then
        notify-send -u critical "System Update" "Authentication failed."
        return 1
    fi

    # Now run pacman normally — sudo uses its cached credentials
    # Terminal stdin is fully available for [Y/n] prompts
    sudo pacman -Syu --noconfirm

    if [ $? -eq 0 ]; then
        notify-send -u normal "System Update" "Update completed."
    else
        notify-send -u critical "System Update" "Update failed."
    fi
}

define(){
    ~/.scripts/bpscripts/shortcuts-menus/define $@
}
